rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds is list
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupCreator(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    function isGroupDeletionApproved(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.groupDeletionApproved == true
        && get(/databases/$(database)/documents/groups/$(groupId)).data.groupDeletionProposalId is string;
    }

    function canDeleteGroupData(groupId) {
      return isSignedIn()
        && (
          isGroupCreator(groupId)
          || (isGroupMember(groupId) && isGroupDeletionApproved(groupId))
        );
    }

    function isGroupDeletionApprovalUpdate(groupId) {
      let proposalId = request.resource.data.groupDeletionProposalId;
      let proposalPath = /databases/$(database)/documents/groups/$(groupId)/group_proposals/$(proposalId);
      let proposal = getAfter(proposalPath).data;
      let members = resource.data.memberIds;
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isGroupMember(groupId)
        && changedKeys.hasOnly(['groupDeletionApproved', 'groupDeletionProposalId'])
        && changedKeys.hasAll(['groupDeletionApproved', 'groupDeletionProposalId'])
        && request.resource.data.groupDeletionApproved == true
        && existsAfter(proposalPath)
        && proposal.type == 'delete_group'
        && proposal.status == 'approved'
        && proposal.responses is map
        && proposal.responses.keys().hasAll(members)
        && proposal.responses.values().hasOnly(['accepted']);
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow list: if isSignedIn();
      
      allow get: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isSignedIn()
        && (
          isGroupMember(groupId)
          || isGroupDeletionApprovalUpdate(groupId)
          || isInvitationResponse()
        );

      allow delete: if canDeleteGroupData(groupId);

      function isInvitationResponse() {
        return request.auth.uid in resource.data.invitedIds
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['invitedIds', 'memberIds', 'members']);
      }
    }

    // Subcolecciones abiertas para lectura autenticada y escritura de miembros
    match /groups/{groupId}/expenses/{expenseId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /groups/{groupId}/expenses/{expenseId}/proposals/{proposalId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /groups/{groupId}/group_proposals/{proposalId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /groups/{groupId}/messages/{messageId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isSignedIn();
    }

    match /groups/{groupId}/history/{historyId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isSignedIn();
    }
  }
}